<Window x:Class="PcMonitoring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:PcMonitoring.ViewModel"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        AllowsTransparency="True"
        WindowStyle="None"
        Title="ПК-Страж"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#888888"
                                   Margin="1,0,1,0"
                                   VerticalAlignment="Stretch"
                                   HorizontalAlignment="Stretch">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Rectangle RadiusX="4" RadiusY="4"
                                                       Fill="#888888"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="#AA000000" CornerRadius="12" Margin="10" Padding="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="#1E1E1E" 
                    CornerRadius="12,0,0,12"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="МЕНЮ" 
                               Foreground="#888" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"/>
                    <Button Content="Мониторинг" Style="{StaticResource NavButton}" Click="Monitoring_Click"/>
                    <Button Content="Комплектующие" Style="{StaticResource NavButton}" Click="Specs_Click"/>
                    <Button Content="Настройки" Style="{StaticResource NavButton}" Click="Settings_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="1">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,5,5,0"
                            Panel.ZIndex="10">

                    <Button Content="—"
                            Width="24"
                            Height="24"
                            FontSize="12"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Minimize_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="#3A3A3A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                    <Button Content="✕"
                            Width="24"
                            Height="24"
                            FontSize="12"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Close_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="#C42B1C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                
                <StackPanel x:Name="WelcomeScreen" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Добро пожаловать в PC Monitor PRO"
                               Foreground="White" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Выберите раздел в меню слева, чтобы начать" 
                               Foreground="#AAA" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="MonitoringScreen" Visibility="Collapsed">

                    <TextBlock Text="Мониторинг в реальном времени"
                    Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Grid Height="530" Background="Transparent">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <Border Background="#2A2A2A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Foreground="White" FontSize="14" Margin="0,0,0,5">
                                        <Run FontWeight="Bold">CPU Load:</Run>
                                        <TextBlock Text="{Binding CpuLoadText}" />
                                        </TextBlock>
                                        <lvc:CartesianChart Series="{Binding CpuSeries}" Width="1000" Height="150"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2A2A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Foreground="White" FontSize="14" Margin="0,0,0,5">
                                        <Run FontWeight="Bold">CPU Temperature:</Run>
                                        <TextBlock Text="{Binding CpuTempText}" />
                                        </TextBlock>
                                        <lvc:CartesianChart Series="{Binding CpuTempSeries}" Width="1000" Height="150"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2A2A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Foreground="White" FontSize="14" Margin="0,0,0,5">
                                        <Run FontWeight="Bold">GPU Load:</Run>
                                        <Run Text="{Binding GpuLoadText}" />
                                        </TextBlock>
                                        <lvc:CartesianChart Series="{Binding GpuSeries}" Width="500" Height="150"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2A2A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Foreground="White" FontSize="14" Margin="0,0,0,5">
                                        <Run FontWeight="Bold">GPU Temp:</Run>
                                        <Run Text="{Binding GpuTempText}" />
                                        </TextBlock>
                                        <lvc:CartesianChart Series="{Binding GpuTempSeries}" Width="500" Height="150"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2A2A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Foreground="White" FontSize="14" Margin="0,0,0,5">
                                        <Run FontWeight="Bold">RAM Usage:</Run>
                                        <Run Text="{Binding RamUsedPercentText}" />
                                        </TextBlock>
                                        <lvc:CartesianChart Series="{Binding RamSeries}" Width="500" Height="150"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </StackPanel>



                <StackPanel x:Name="SpecsScreen" Visibility="Collapsed">
                    <TextBlock Text="Информация о системе" 
                               Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Border Background="#2A2A2A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Foreground="White" FontSize="14">
                            <Run FontWeight="Bold" Foreground="#6DB3F2">CPU:</Run><LineBreak/>
                            <Run Text="{Binding Cpu, Mode=OneTime}"/>
                            </TextBlock>
                            <Separator Margin="0,10,0,10" Background="#444"/>
                            <TextBlock Foreground="White" FontSize="14">
                            <Run FontWeight="Bold" Foreground="#6DB3F2">GPU:</Run><LineBreak/>
                            <Run Text="{Binding Gpu, Mode=OneTime}"/>
                            </TextBlock>
                            <Separator Margin="0,10,0,10" Background="#444"/>
                            <TextBlock Foreground="White" FontSize="14">
                            <Run FontWeight="Bold" Foreground="#6DB3F2">Материнская плата:</Run><LineBreak/>
                            <Run Text="{Binding Motherboard, Mode=OneTime}"/>
                            </TextBlock>
                            <Separator Margin="0,10,0,10" Background="#444"/>
                            <TextBlock Foreground="White" FontSize="14">
                            <Run FontWeight="Bold" Foreground="#6DB3F2">ОЗУ:</Run><LineBreak/>
                            <Run Text="{Binding Ram, Mode=OneTime}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="#2A2A2A" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10">
                                <Run Foreground="#6DB3F2">Диски:</Run>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Disks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Foreground="White" FontSize="14" Margin="0,4" Text="{Binding}"/>
                                            <Separator Margin="0,8,0,2" Background="#444"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>