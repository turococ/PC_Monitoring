<Window x:Class="HardwareMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        AllowsTransparency="True"
        WindowStyle="None"
        Title="Hardware Monitor"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border
        Background="#AA000000"
        CornerRadius="12"
        Margin="10"
        Padding="10">
        
        <StackPanel>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">

                    <TextBlock
                        Foreground="White"
                        FontWeight="Bold"
                        DockPanel.Dock="Left"/>

                    <Button
                    Content="✕"
                    Width="32"
                    Height="32"
                    FontSize="16"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Close_Click"
                    DockPanel.Dock="Right">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#383838"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#303030"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>

                <StackPanel Grid.Row="1" Margin="0 10 0 0">
                    <TextBlock
                        Text="Specs"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Center"/>

                    <Separator Margin="0 0 0 10"/>

                    <TextBlock Text="{Binding MotherBoard}" Foreground="White" FontSize="14"/>
                    <TextBlock Text="{Binding Cpu}"         Foreground="White" FontSize="14"/>
                    <TextBlock Text="{Binding Gpu}"         Foreground="White" FontSize="14"/>
                    <TextBlock Text="{Binding Ram}"         Foreground="White" FontSize="14"/>
                    <TextBlock 
                        Text="Disks:" 
                        Foreground="White" 
                        FontSize="16"
                        Margin="0 10 0 5"/>

                    <ListBox 
                        ItemsSource="{Binding Disks}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"> 

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock 
                                    Text="{Binding}" 
                                    Foreground="White"
                                    FontSize="14"/> 
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
